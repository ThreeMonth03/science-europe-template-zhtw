<div id="q-docs-metadata" class="question">
  {# __tr_block_0000:start #}<h3>3. What metadata and documentation (for example the methodology of data collection and way of organising data) will accompany the data?</h3>{# __tr_block_0000:end #}

  <div class="answer">
  {% set answerContent %}

    {# Metadata #}
    <div class="dataset-policy metadata-policy">
    {%- set metadataPath = [uuids.creatingCUuid, uuids.metadataQUuid]|reply_path -%}
    {%- set metadataAUuid = repliesMap[metadataPath]|reply_str_value -%}
    {%- if metadataAUuid == uuids.metadataExploreAUuid -%}

      {# Metadata standards #}
      {%- set metadataSentences = [] -%}
      {%- set metadataStandardsPath = [metadataPath, uuids.metadataExploreAUuid, uuids.metadataStandardsQUuid]|reply_path -%}
      {%- set metadataStandardsAUuid = repliesMap[metadataStandardsPath]|reply_str_value -%}
      {%- if metadataStandardsAUuid == uuids.metadataStandardsExploreAUuid -%}
        {%- set metadataStandardsDCPath = [metadataStandardsPath, uuids.metadataStandardsExploreAUuid, uuids.metadataStandardsDCQUuid]|reply_path -%}
        {%- set metadataStandardsDCAUuid = repliesMap[metadataStandardsDCPath]|reply_str_value -%}
        {%- set metadataStandardsDataCityPath = [metadataStandardsPath, uuids.metadataStandardsExploreAUuid, uuids.metadataStandardsDataCiteQUuid]|reply_path -%}
        {%- set metadataStandardsDataCityAUuid = repliesMap[metadataStandardsDataCityPath]|reply_str_value -%}
        {%- set metadataStandardsDDIPath = [metadataStandardsPath, uuids.metadataStandardsExploreAUuid, uuids.metadataStandardsDDIQUuid]|reply_path -%}
        {%- set metadataStandardsDDIAUuid = repliesMap[metadataStandardsDDIPath]|reply_str_value -%}
        {%- set metadataStandardsKeywordsPath = [metadataStandardsPath, uuids.metadataStandardsExploreAUuid, uuids.metadataStandardsKeywordsQUuid]|reply_path -%}
        {%- set metadataStandardsKeywordsAUuid = repliesMap[metadataStandardsKeywordsPath]|reply_str_value -%}


        {%- set metadataStandards = [] -%}
        {%- if metadataStandardsDCAUuid == uuids.metadataStandardsDCYesAUuid -%}{# __tr_block_0001:start #}
          {%- do metadataStandards.append("Dublin Core") -%}
        {# __tr_block_0001:end #}{%- endif -%}
        {%- if metadataStandardsDataCityAUuid == uuids.metadataStandardsDataCiteYesAUuid -%}{# __tr_block_0002:start #}
          {%- do metadataStandards.append("DataCite") -%}
        {# __tr_block_0002:end #}{%- endif -%}
        {%- if metadataStandardsDDIAUuid == uuids.metadataStandardsDDIYesAUuid -%}{# __tr_block_0003:start #}
          {%- do metadataStandards.append("DDI (Data Documentation Initiative)") -%}
        {# __tr_block_0003:end #}{%- endif -%}
        {%- if metadataStandards|length == 1 -%}
          {# __tr_append_sentence_original:eyUtIGRvIG1ldGFkYXRhU2VudGVuY2VzLmFwcGVuZCgiV2Ugd2lsbCBiZSBkb2N1bWVudGluZyB0aGUgZGF0YSB3aXRoICIgfiBtZXRhZGF0YVN0YW5kYXJkc1swXSB-ICIgbWV0YWRhdGEgc3RhbmRhcmQuIikgLSV9 #}{%- set __tr_append_sentence_0000 -%}{# __tr_block_0004:start #}We will be documenting the data with {{ metadataStandards[0] }} metadata standard.{# __tr_block_0004:end #}{%- endset -%}{%- do metadataSentences.append(__tr_append_sentence_0000) -%}{# __tr_append_sentence_original:end -#}
        {%- elif metadataStandards|length == 2 -%}
          {# __tr_append_sentence_original:eyUtIGRvIG1ldGFkYXRhU2VudGVuY2VzLmFwcGVuZCgiV2Ugd2lsbCBiZSBkb2N1bWVudGluZyB0aGUgZGF0YSB3aXRoICIgfiBtZXRhZGF0YVN0YW5kYXJkc1swXSB-ICIgYW5kICIgfiBtZXRhZGF0YVN0YW5kYXJkc1sxXSB-ICIgbWV0YWRhdGEgc3RhbmRhcmRzLiIpIC0lfQ== #}{%- set __tr_append_sentence_0001 -%}{# __tr_block_0005:start #}We will be documenting the data with {{ metadataStandards[0] }} and {{ metadataStandards[1] }} metadata standards.{# __tr_block_0005:end #}{%- endset -%}{%- do metadataSentences.append(__tr_append_sentence_0001) -%}{# __tr_append_sentence_original:end -#}
        {%- elif metadataStandards|length == 3 -%}
          {# __tr_append_sentence_original:eyUtIGRvIG1ldGFkYXRhU2VudGVuY2VzLmFwcGVuZCgiV2Ugd2lsbCBiZSBkb2N1bWVudGluZyB0aGUgZGF0YSB3aXRoICIgfiBtZXRhZGF0YVN0YW5kYXJkc1swXSB-ICIsICIgfiBtZXRhZGF0YVN0YW5kYXJkc1sxXSB-ICIsIGFuZCAiIH4gbWV0YWRhdGFTdGFuZGFyZHNbMl0gfiAiIG1ldGFkYXRhIHN0YW5kYXJkcy4iKSAtJX0= #}{%- set __tr_append_sentence_0002 -%}{# __tr_block_0006:start #}We will be documenting the data with {{ metadataStandards[0] }}, {{ metadataStandards[1] }}, and {{ metadataStandards[2] }} metadata standards.{# __tr_block_0006:end #}{%- endset -%}{%- do metadataSentences.append(__tr_append_sentence_0002) -%}{# __tr_append_sentence_original:end -#}
        {%- endif -%}
        {%- if metadataStandardsKeywordsAUuid == uuids.metadataStandardsKeywordsYesAUuid -%}{# __tr_block_0007:start #}
          {%- do metadataSentences.append("We will include keywords and relevant ontology references to optimize the possibility for discovery and potential reuse.") -%}
        {# __tr_block_0007:end #}{%- endif -%}
      {%- endif -%}

      {%- set provenanceW3CPath = [metadataPath, uuids.metadataExploreAUuid, uuids.provenanceW3CQUuid]|reply_path -%}
      {%- set provenanceW3CAUuid = repliesMap[provenanceW3CPath]|reply_str_value -%}
      {%- if provenanceW3CAUuid == uuids.provenanceW3CYesAUuid -%}{# __tr_block_0008:start #}
          {%- do metadataSentences.append("The provenance will be captured using W3C PROV.") -%}
      {# __tr_block_0008:end #}{%- endif -%}

      {%- if metadataSentences|length > 0 -%}
        <p>{{ metadataSentences|join(" ") }}</p>
      {%- endif -%}
      {# This answer is independent of standards and metadata publication. #}
      {%- set dictionary = repliesMap[[metadataPath, uuids.metadataExploreAUuid, uuids.metadataDictionaryQUuid]|reply_path]|reply_str_value -%}
      {%- if dictionary == uuids.metadataDictionaryYesAUuid -%}
        {# __tr_block_0009:start #}<p data-fact-id="metadata-dictionary" data-status="complete">We will create a data/variable dictionary.</p>{# __tr_block_0009:end #}
      {%- elif dictionary == uuids.metadataDictionaryNoAUuid -%}
        {# __tr_block_0010:start #}<p data-fact-id="metadata-dictionary" data-status="explicit-no">We will not create a data/variable dictionary.</p>{# __tr_block_0010:end #}
      {%- else -%}
        <div class="reading-gap">
          {%- if dictionary|trim -%}
          {# __tr_block_0011:start #}<p class="data-gap" data-fact-id="metadata-dictionary" data-status="needs-review">The selected data-dictionary option cannot be represented by this template; please review it.</p>{# __tr_block_0011:end #}
          {%- else -%}
          {# __tr_block_0012:start #}<p class="data-gap" data-fact-id="metadata-dictionary" data-status="missing">Information not provided: whether a data/variable dictionary will be created.</p>{# __tr_block_0012:end #}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {# Publishing metadata #}
    {%- set metadataOpenPath = [uuids.accessCUuid, uuids.metadataOpenQUuid]|reply_path -%}
    {%- set metadataOpenAUuid = repliesMap[metadataOpenPath]|reply_str_value -%}
    {%- if metadataOpenAUuid == uuids.metadataOpenNoAUuid %}
      {%- set explanation = repliesMap[[metadataOpenPath, metadataOpenAUuid, uuids.metadataOpenNoExplainQUuid]|reply_path]|reply_str_value -%}
      {# __tr_block_0013:start #}<p>Metadata will not be available openly.</p>{# __tr_block_0013:end #}
      {%- if explanation|trim -%}
        <div class="answer-detail" data-fact-id="metadata-access-explanation">{{ explanation|markdown }}</div>
      {%- else -%}
        <div class="reading-gap">{# __tr_block_0014:start #}<p class="data-gap" data-fact-id="metadata-access-explanation" data-status="missing">Information not provided: why the metadata will not be openly available.</p>{# __tr_block_0014:end #}</div>
      {%- endif -%}
    {%- elif metadataOpenAUuid == uuids.metadataOpenYesAUuid -%}
      {%- set metadataOpenInstrAUuid = repliesMap[[metadataOpenPath, metadataOpenAUuid, uuids.metadataOpenInstrQUuid]|reply_path]|reply_str_value -%}
      {%- set metadataOpenFormAUuid = repliesMap[[metadataOpenPath, metadataOpenAUuid, uuids.metadataOpenFormQUuid]|reply_path]|reply_str_value -%}
      {# __tr_block_0015:start #}<p>
      {%- if metadataOpenInstrAUuid == uuids.metadataOpenInstrYesAUuid %}
        Metadata will be openly available including instructions how to get access to the data.
      {%- elif metadataOpenInstrAUuid == uuids.metadataOpenInstrNoAUuid %}
        Metadata will be openly available without instructions how to get access to the data.
      {%- else %}
        Metadata will be openly available.
      {%- endif %}
      {%- if metadataOpenFormAUuid == uuids.metadataOpenFormNoAUuid %}
        Metadata will not be available in a form that can be harvested and indexed.
      {%- elif metadataOpenFormAUuid == uuids.metadataOpenFormYesRepoAUuid %}
        Metadata will be available in a form that can be harvested and indexed (managed by the used repository / repositories).
      {%- elif metadataOpenFormAUuid == uuids.metadataOpenFormYesCareAUuid %}
        Metadata will be available in a form that can be harvested and indexed.
      {%- endif %}
      </p>{# __tr_block_0015:end #}
      {%- set instructionKnown = metadataOpenInstrAUuid in [uuids.metadataOpenInstrYesAUuid, uuids.metadataOpenInstrNoAUuid] -%}
      {%- set formKnown = metadataOpenFormAUuid in [uuids.metadataOpenFormNoAUuid, uuids.metadataOpenFormYesRepoAUuid, uuids.metadataOpenFormYesCareAUuid] -%}
      {%- if not instructionKnown or not formKnown -%}
      <div class="reading-gap">
        {%- if not metadataOpenInstrAUuid|trim and not metadataOpenFormAUuid|trim -%}
          {# __tr_block_0016:start #}<p class="data-gap metadata-publication-gap">Information not provided: <span data-fact-id="metadata-access-instructions" data-status="missing">whether the metadata will include instructions for accessing the data</span>; <span data-fact-id="metadata-harvestable" data-status="missing">whether the metadata will be available in a form that can be harvested and indexed</span>.</p>{# __tr_block_0016:end #}
        {%- else -%}
        {%- if not instructionKnown -%}
          {%- if metadataOpenInstrAUuid|trim -%}
          {# __tr_block_0017:start #}<p class="data-gap" data-fact-id="metadata-access-instructions" data-status="needs-review">The selected metadata access-instructions option cannot be represented by this template; please review it.</p>{# __tr_block_0017:end #}
          {%- else -%}
          {# __tr_block_0018:start #}<p class="data-gap" data-fact-id="metadata-access-instructions" data-status="missing">Information not provided: whether the metadata will include instructions for accessing the data.</p>{# __tr_block_0018:end #}
          {%- endif -%}
        {%- endif -%}
        {%- if not formKnown -%}
          {%- if metadataOpenFormAUuid|trim -%}
          {# __tr_block_0019:start #}<p class="data-gap" data-fact-id="metadata-harvestable" data-status="needs-review">The selected metadata harvesting and indexing option cannot be represented by this template; please review it.</p>{# __tr_block_0019:end #}
          {%- else -%}
          {# __tr_block_0020:start #}<p class="data-gap" data-fact-id="metadata-harvestable" data-status="missing">Information not provided: whether the metadata will be available in a form that can be harvested and indexed.</p>{# __tr_block_0020:end #}
          {%- endif -%}
        {%- endif -%}
        {%- endif -%}
      </div>
      {%- endif -%}
    {%- endif -%}
    </div>

  {# Storage and file conventions #}
  {%- set storageConvPath = [uuids.processingCUuid, uuids.storageConvQUuid]|reply_path -%}
  {%- set storageConvAUuid = repliesMap[storageConvPath]|reply_str_value -%}
  {%- if storageConvAUuid == uuids.storageConvExploreAUuid -%}
    {%- set stConvPrefix = [storageConvPath, uuids.storageConvExploreAUuid]|reply_path -%}
    {%- set storageSpacePath = [stConvPrefix, uuids.storageSpaceQUuid]|reply_path -%}
    {%- set storageSpaceAUuid = repliesMap[storageSpacePath]|reply_str_value -%}
    {%- set storageConvFSysPath = [stConvPrefix, uuids.storageConvFSysQUuid]|reply_path -%}
    {%- set storageConvFSysAUuid = repliesMap[storageConvFSysPath]|reply_str_value -%}
    {%- set storageConvObjStorePath = [stConvPrefix, uuids.storageConvObjStoreQUuid]|reply_path -%}
    {%- set storageConvObjStoreAUuid = repliesMap[storageConvObjStorePath]|reply_str_value -%}
    {%- set storageConvRelDbPath = [stConvPrefix, uuids.storageConvRelDbQUuid]|reply_path -%}
    {%- set storageConvRelDbAUuid = repliesMap[storageConvRelDbPath]|reply_str_value -%}
    {# Capacity is an independent answer, not conditional on a storage technology. #}
    {%- if storageSpaceAUuid or storageConvFSysAUuid or storageConvObjStoreAUuid or storageConvRelDbAUuid -%}
      {# __tr_block_0021:start #}<h4>Data storage and file conventions</h4>{# __tr_block_0021:end #}
      <div class="dataset-policy storage-conventions-policy">
      {# Storage space #}
      {%- if storageSpaceAUuid == uuids.storageSpaceLittleAUuid -%}
        {# __tr_block_0022:start #}<p>The project will require so little storage space for all data and software (including temporary storage) that it is not a problem.</p>{# __tr_block_0022:end #}
      {%- elif storageSpaceAUuid == uuids.storageSpaceSpecifyAUuid -%}
        {%- set size = repliesMap[[storageSpacePath, storageSpaceAUuid, uuids.storageSpaceSpecifyQUuid]|reply_path]|reply_str_value -%}
        {%- if size|trim -%}
        {# __tr_block_0023:start #}<p>We estimate the storage space that the project will require for all data and software (including temporary storage) to be {{ size|e }} gigabytes.</p>{# __tr_block_0023:end #}
        {%- else -%}
        <div class="reading-gap">
          {# __tr_block_0024:start #}<p class="data-gap" data-fact-id="storage-capacity" data-status="missing">Information not provided: the estimated storage space for all project data and software, including temporary storage (GB).</p>{# __tr_block_0024:end #}
        </div>
        {%- endif -%}
      {%- endif -%}
      {# File System #}
      {%- if storageConvFSysAUuid == uuids.storageConvFSysNoAUuid -%}
        {# __tr_block_0025:start #}<p>We will not use a filesystem with files and folders.</p>{# __tr_block_0025:end #}
      {%- elif storageConvFSysAUuid == uuids.storageConvFSysYesAUuid -%}
        {%- set scFSysPrefix = [storageConvFSysPath, uuids.storageConvFSysYesAUuid]|reply_path -%}
        {# Folder types #}
        {%- set scFSysSubjFoldersPath = [scFSysPrefix, uuids.scFSysSubjFoldersQUuid]|reply_path -%}
        {%- set scFSysSubjFoldersAUuid = repliesMap[scFSysSubjFoldersPath]|reply_str_value -%}
        {%- set scFSysAnalysisFoldersPath = [scFSysPrefix, uuids.scFSysAnalysisFoldersQUuid]|reply_path -%}
        {%- set scFSysAnalysisFoldersAUuid = repliesMap[scFSysAnalysisFoldersPath]|reply_str_value -%}
        {%- set scFSysWorkflowStepFoldersPath = [scFSysPrefix, uuids.scFSysWorkflowStepFoldersQUuid]|reply_path -%}
        {%- set scFSysWorkflowStepFoldersAUuid = repliesMap[scFSysWorkflowStepFoldersPath]|reply_str_value -%}
        {%- set subjectFolders = scFSysSubjFoldersAUuid == uuids.scFSysSubjFoldersYesAUuid -%}
        {%- set analysisFolders = scFSysAnalysisFoldersAUuid == uuids.scFSysAnalysisFoldersYesAUuid -%}
        {%- set workflowStepFolders = scFSysWorkflowStepFoldersAUuid == uuids.scFSysWorkflowStepFoldersYesAUuid -%}
        {%- set folders = [subjectFolders, analysisFolders, workflowStepFolders] -%}
        {%- if folders|any -%}
          {# __tr_block_0026:start #}<p>We will use a filesystem with files and folders with the following folder conventions:</p>{# __tr_block_0026:end #}
          <ul>
            {%- if subjectFolders -%}
              {%- set scFSysSubjFoldersConvs = repliesMap[[scFSysSubjFoldersPath, uuids.scFSysSubjFoldersYesAUuid, uuids.scFSysSubjFoldersConvsQUuid]|reply_path]|reply_str_value -%}
              {# __tr_block_0027:start #}<li>
                There will be a <strong>folder for each sample/subject</strong>.
                {% if scFSysSubjFoldersConvs %}
                  <div class="answer-detail"><div class="answer-lead"><p>Each of those will use the following conventions:</p></div>{{ scFSysSubjFoldersConvs|markdown }}</div>
                {%- endif -%}
              </li>{# __tr_block_0027:end #}
            {%- endif -%}
            {%- if analysisFolders -%}
              {%- set scFSysAnalysisFoldersConvs = repliesMap[[scFSysAnalysisFoldersPath, uuids.scFSysAnalysisFoldersYesAUuid, uuids.scFSysAnalysisFoldersConvsQUuid]|reply_path]|reply_str_value -%}
              {# __tr_block_0028:start #}<li>
                There will be  a <strong>(sub)folder for each (repeated) analysis</strong>. 
                {% if scFSysAnalysisFoldersConvs %}
                  <div class="answer-detail"><div class="answer-lead"><p>Each of those will use the following conventions:</p></div>{{ scFSysAnalysisFoldersConvs|markdown }}</div>
                {%- endif -%}
              </li>{# __tr_block_0028:end #}
            {%- endif -%}
            {%- if workflowStepFolders -%}
              {%- set scFSysWorkflowStepFoldersConvs = repliesMap[[scFSysWorkflowStepFoldersPath, uuids.scFSysWorkflowStepFoldersYesAUuid, uuids.scFSysWorkflowStepFoldersConvsQUuid]|reply_path]|reply_str_value -%}
              {# __tr_block_0029:start #}<li>
                There will be a <strong>(sub)folder for each step in the analysis workflow</strong>.
                {% if scFSysWorkflowStepFoldersConvs %}
                  <div class="answer-detail"><div class="answer-lead"><p>Each of those will use the following conventions:</p></div>{{ scFSysWorkflowStepFoldersConvs|markdown }}</div>
                {%- endif -%}
              </li>{# __tr_block_0029:end #}
            {%- endif -%}
          </ul>
        {%- else -%}
          {# __tr_block_0030:start #}<p>We will use a filesystem with files and folders.</p>{# __tr_block_0030:end #}
        {%- endif -%}
        {# Versioning #}
        {%- set scDocumentVersioningPath = [scFSysPrefix, uuids.scDocumentVersioningQUuid]|reply_path -%}
        {%- set scDocumentVersioningAUuid = repliesMap[scDocumentVersioningPath]|reply_str_value -%}
        {%- if scDocumentVersioningAUuid == uuids.scDocumentVersioningYesAUuid %}
          {# __tr_block_0031:start #}<p>We document how we manage file versioning for files and folders.</p>{# __tr_block_0031:end #}
        {%- endif -%}
        {# Other appointments #}
        {%- set scFSysAppointmentsPath = [scFSysPrefix, uuids.scFSysAppointmentsQUuid]|reply_path -%}
        {%- set scFSysAppointments = repliesMap[scFSysAppointmentsPath]|reply_str_value -%}
        {%- if scFSysAppointments %}
          <div class="answer-detail" data-fact-id="file-naming"><div class="answer-lead">{# __tr_block_0032:start #}<p>File naming conventions:</p>{# __tr_block_0032:end #}</div>{{ scFSysAppointments|markdown }}</div>
        {%- endif -%}
      {%- endif -%}
      {# Object and Document Store #}
      {%- if storageConvObjStoreAUuid == uuids.storageConvObjStoreNoAUuid -%}
        {# __tr_block_0033:start #}<p>We will not be storing data in an "object/document store" system.</p>{# __tr_block_0033:end #}
      {%- elif storageConvObjStoreAUuid == uuids.storageConvObjStoreYesAUuid -%}
        {%- set scObjStoreNamingQUuid = [storageConvObjStorePath, uuids.storageConvObjStoreYesAUuid, uuids.scObjStoreNamingQUuid]|reply_path -%}
        {%- set scObjStoreNaming = repliesMap[scObjStoreNamingQUuid]|reply_str_value -%}
        {# __tr_block_0034:start #}<p>We will be storing data in an "object/document store" system.</p>{# __tr_block_0034:end #}
        {%- if scObjStoreNaming -%}
          <div class="answer-detail" data-fact-id="object-naming"><div class="answer-lead">{# __tr_block_0035:start #}<p>Object naming conventions:</p>{# __tr_block_0035:end #}</div>{{ scObjStoreNaming|markdown }}</div>
        {%- endif -%}
      {%- endif -%}
      {# Databases #}
      {%- if storageConvRelDbAUuid == uuids.storageConvRelDbNoAUuid -%}
        {# __tr_block_0036:start #}<p>We will not use a database system to store project data.</p>{# __tr_block_0036:end #}
      {%- elif storageConvRelDbAUuid == uuids.storageConvRelDbYesAUuid -%}
        {# __tr_block_0037:start #}<p>
        We will use a database system to store project data.
        {%- set scRelDbHandleChangesPath = [storageConvRelDbPath, uuids.storageConvRelDbYesAUuid, uuids.scRelDbHandleChangesQUuid]|reply_path -%}
        {%- set scRelDbHandleChangesAUuid = repliesMap[scRelDbHandleChangesPath]|reply_str_value -%}
        {%- if scRelDbHandleChangesAUuid == uuids.scRelDbReadOnlyAnswerUuid %}
          Data in the database will be read-only.
        {%- elif scRelDbHandleChangesAUuid == uuids.scRelDbCrudAnswerUuid %}
          We will be allowing Create, Update and Delete operations for data in the database.
        {%- elif scRelDbHandleChangesAUuid == uuids.scRelDbExpireAnswerUuid %}
          Modifications will be made by <em>Expiring</em> the existing data and <em>Adding</em> updated data.
        {%- endif -%}
        </p>{# __tr_block_0037:end #}
      {%- endif -%}
      </div>
    {%- endif -%}
  {%- endif -%}

  {% endset %}
  {% if answerContent|striptags|trim or '<img' in answerContent or '<table' in answerContent %}
    {{ answerContent }}
  {% else %}
    {# __tr_block_0038:start #}<p class="data-gap" data-requirement-id="SE-2a" data-status="missing-output">This document does not yet contain an answer about metadata and documentation.</p>{# __tr_block_0038:end #}
  {% endif %}
  </div>
</div>
