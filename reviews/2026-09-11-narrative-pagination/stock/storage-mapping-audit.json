    "zh-Hant": {
      "km_sha256": "a3030cb9048a8842fe43ebac9ece00011e26936111789443d85422473c4cae47",
      "questions": [
        {
          "binding": "sharedWorkspaceQUuid",
          "uuid": "72099c46-16e7-47a2-a320-cc768b7085fe",
          "path": [
            "10a10ffd-bfe1-4c6b-bbb6-3dfb1e63a5d5",
            "72099c46-16e7-47a2-a320-cc768b7085fe"
          ],
          "title": "您是否會使用共享的工作空間來處理您的資料？",
          "text": "您是否會使用一個包含本專案特定資料與軟體的工作空間，並讓專案中所有處理資料的人共同使用？這類系統有時稱為「虛擬研究環境」。",
          "answers": [
            {
              "uuid": "1d6ba101-fd62-43c8-ab53-76bc31847f58",
              "label": "否，專案參與者各自使用不同的資料與工具"
            },
            {
              "uuid": "e7324e1a-bfcb-4f2b-855a-35701dfb1ad5",
              "label": "是"
            }
          ]
        },
        {
          "binding": "sharedSpecialistsQUuid",
          "uuid": "5607d0bb-6b9e-4211-821c-785acc3aa25e",
          "path": [
            "10a10ffd-bfe1-4c6b-bbb6-3dfb1e63a5d5",
            "72099c46-16e7-47a2-a320-cc768b7085fe",
            "e7324e1a-bfcb-4f2b-855a-35701dfb1ad5",
            "5607d0bb-6b9e-4211-821c-785acc3aa25e"
          ],
          "title": "這個工作空間是否會由專責人員負責營運？",
          "text": "如果您的工作空間是由專責人員負責營運與維護，例如由參與專案的某個機構之資訊通訊部門負責，這表示備份與復原，以及取用管理，都已獲得妥善處理。",
          "answers": [
            {
              "uuid": "bcbc8cf6-7ba6-40d4-be2b-db85cb9e26c1",
              "label": "否"
            },
            {
              "uuid": "35b32d04-fec6-465e-976d-466aafcb385d",
              "label": "是"
            }
          ]
        },
        {
          "binding": "sharedReliableBackupQUuid",
          "uuid": "98d9789b-32fc-4e2f-876a-47760ad7c7ec",
          "path": [
            "10a10ffd-bfe1-4c6b-bbb6-3dfb1e63a5d5",
            "72099c46-16e7-47a2-a320-cc768b7085fe",
            "e7324e1a-bfcb-4f2b-855a-35701dfb1ad5",
            "b171ec17-d7b5-4726-ae22-0d892b106cf8",
            "0d64d3c6-4312-47a9-92ad-0bc9440d6e45",
            "98d9789b-32fc-4e2f-876a-47760ad7c7ec"
          ],
          "title": "您是否會為工作空間之外的專案資料製作備份？",
          "text": "專案成員的筆記型電腦等設備中是否存有任何資料檔案？此外，超級運算中心及其他高效能運算中心通常會在使用條款中註明，使用者須自行負責資料備份。",
          "answers": [
            {
              "uuid": "7c732053-6df4-466b-8732-0db2bd1e1ffc",
              "label": "這由專案參與者自行處理"
            },
            {
              "uuid": "a1ead63a-1bc8-42e6-8bdc-3e1e8a901307",
              "label": "其他地方沒有資料"
            },
            {
              "uuid": "278810f9-6396-4203-9fa6-6cd3a003159c",
              "label": "所有他處資料皆已適當備份"
            },
            {
              "uuid": "0884ac19-9bde-4bf1-afdd-0794c2c69092",
              "label": "我們會自動備份所有儲存在工作空間之外的資料"
            }
          ]
        },
        {
          "binding": "archivedDuringQUuid",
          "uuid": "d5784d24-0e66-4821-bd62-a711fb6d7a40",
          "path": [
            "d5b27482-b598-4b8c-b534-417d4ad27394",
            "d5784d24-0e66-4821-bd62-a711fb6d7a40"
          ],
          "title": "您是否會在專案期間，就以所謂的「冷儲存」方式典藏資料，以利長期保存？",
          "text": "您所擁有的大部分原始資料，之後都需要在某處加以典藏，以供您日後自行使用。這通常是在離線環境下以磁帶進行，而不是存放在運算設施的磁碟上。請注意，這裡指的並不是資料發布。",
          "answers": [
            {
              "uuid": "a547dc69-a3e8-46e4-bb4b-21fd104231f9",
              "label": "否"
            },
            {
              "uuid": "e81599af-4519-4987-b74e-9545428ed0e3",
              "label": "是"
            }
          ]
        },
        {
          "binding": "archivedDuringReQUuid",
          "uuid": "c659c36f-d142-4453-8d8b-db7c05f31371",
          "path": [
